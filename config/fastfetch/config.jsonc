// Load with --load-config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "custom", // HardwareStart
      "format": "┌──────────── \u001b[1mHardware Information\u001b[0m ────────────┐" // `\u001b` is `\033`, or `\e`
    },
    {
      "type": "host",
      "key": "  󰌢",
      "format": "{2}"
    },
    {
      "type": "cpu",
      "key": "  󰻠",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "  󰍛",
      "format": "{1} {2}"
    },
    {
      "type": "disk",
      "key": "  "
    },
    {
      "type": "memory",
      "key": "  󰑭"
    },
    {
      "type": "swap",
      "key": "  󰓡"
    },
    // {
    //   "type": "display",
    //   "key": "  󰍹"
    // },
    {
      "type": "poweradapter",
      "key": "  "
    },
    {
      "type": "sound",
      "key": "  ",
      "format": "{1} ({3})"
    },
    {
      "type": "custom", // SoftwareStart
      "format": "├──────────── \u001b[1mSoftware Information\u001b[0m ────────────┤"
    },
    {
      "type": "title",
      "key": "  ",
      "format": "{1}@{2}"
    },
    {
      "type": "os",
      "key": "  " // Just get your distro's logo off nerdfonts.com
    },
    {
      "type": "kernel",
      "key": "  ",
      "format": "{1} {2}"
    },
    {
      "type": "lm",
      "key": "  󰧨"
    },
    {
      "type": "de",
      "key": "  "
    },
    {
      "type": "wm",
      "key": "  "
    },
    {
      "type": "shell",
      "key": "  "
    },
    {
      "type": "terminal",
      "key": "  "
    },
    {
      "type": "terminalfont",
      "key": "  "
    },
    {
      "type": "theme",
      "key": "  󰉼"
    },
    {
      "type": "icons",
      "key": "  󰀻"
    },
    {
      "type": "packages",
      "key": "  󰏖"
    },
    {
      "type": "uptime",
      "key": "  󰅐"
    },
    {
      "type": "media",
      "key": "  󰝚",
      "format": "{1}"
    },
    {
      "type": "localip",
      "key": "  󰩟",
      "compact": true
    },
    // {
    //   "type": "publicip",
    //   "key": "  󰩠"
    // },
    // {
    //   "type": "wifi",
    //   "key": "  ",
    //   "format": "{4}" // ssid
    // },
    {
      "type": "custom", // InformationEnd
      "format": "└──────────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
