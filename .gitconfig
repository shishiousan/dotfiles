[user]
	email = shimizu.shion819@gmail.com
	name = shion
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    
    line-numbers = true   
    side-by-side = true  

[merge]
  tool = meld
    conflictstyle = diff3

[diff]
    colorMoved = default
  tool = meld
[init]
	defaultBranch = main

[difftool "meld"]
  cmd = meld $LOCAL $REMOTE
[mergetool "meld"]
  cmd = meld $LOCAL $BASE $REMOTE --auto-merge

